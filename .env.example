# Copier ce fichier en .env (jamais commité) et remplacer les mots de passe.
# Générer un mot de passe : python -c "import secrets; print(secrets.token_urlsafe(24))"

# --- Conteneur PostgreSQL (docker compose) ---
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=chinook_admin
POSTGRES_ADMIN_PASSWORD=a-remplacer-admin
AGENT_DB_PASSWORD=a-remplacer-agent

# --- Application (serveur MCP) ---
# AGENT_DB_PASSWORD ci-dessus est aussi lu par l'application.
# Valeurs par défaut définies dans src/text_to_sql_mcp/config.py, à décommenter pour les changer :
# POSTGRES_HOST=127.0.0.1
# POSTGRES_DB=chinook
# DB_SCHEMA=public
# AGENT_DB_USER=agent_lecteur
# CONNECT_TIMEOUT=5
