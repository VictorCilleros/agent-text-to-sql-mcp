# Copier ce fichier en .env (jamais commité) et remplacer les mots de passe et la clé.
# Générer un mot de passe : python -c "import secrets; print(secrets.token_urlsafe(24))"

# --- Conteneur PostgreSQL (docker compose) ---
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=chinook_admin
POSTGRES_ADMIN_PASSWORD=a-remplacer-admin
AGENT_DB_PASSWORD=a-remplacer-agent

# --- Application (serveur MCP) ---
# AGENT_DB_PASSWORD ci-dessus est aussi lu par l'application.
# Valeurs par défaut définies dans src/text_to_sql_mcp/config.py, à décommenter pour les changer :
# POSTGRES_HOST=127.0.0.1
# POSTGRES_DB=chinook
# DB_SCHEMA=public
# AGENT_DB_USER=agent_lecteur
# CONNECT_TIMEOUT=5
# ROW_CAP=100
# Durée maximale d'une requête en secondes, de 1 à 30 (le rôle PostgreSQL plafonne à 30 s) :
# STATEMENT_TIMEOUT=5
# LOG_LEVEL=INFO

# --- Agent (commande text-to-sql-agent) ---
# Clé de l'API Anthropic, lue uniquement par l'agent (jamais transmise au serveur MCP).
ANTHROPIC_API_KEY=sk-ant-a-remplacer
# Valeurs par défaut (AgentSettings dans config.py), surchargeables aussi par les options du CLI :
# AGENT_MODEL=claude-sonnet-5-5
# Nom d'un fichier de src/text_to_sql_mcp/agent/prompts/, sans l'extension .md :
# AGENT_PROMPT=v0
# Nombre maximal d'appels à l'API par question (de 1 à 50) :
# AGENT_MAX_TURNS=10
# AGENT_MAX_TOKENS=8000
